#!name=🧰 Common Tools
#!desc=Common Tools for All
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

[Rewrite]
# SMZDM
response if ${url} ~= /^https:\/\/app-api\.smzdm\.com\/mychannel\/list$/i then response.body.mock("text", "{}", 200)

[Script]
# bilibili
response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/ifflagged/Module-Top/BiliBili.js") with tag="BiliBili Tab", requires_body=true

response if ${url} ~= /^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/ifflagged/Module-Top/BiliBili.js") with tag="BiliBili My Info", requires_body=true

# DiDi
response if ${url} ~= /^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v\d\/core/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/ifflagged/Module-Top/DiDi.js") with tag="DiDi Tab", requires_body=true

