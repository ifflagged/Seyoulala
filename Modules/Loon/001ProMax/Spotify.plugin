#!name=Spotify去广告
#!desc=移除播放广告，恢复歌手列表的正常展示\n首次使用或修改参数需重新登录以生效
#!author=app2smile[https://github.com/app2smile], 001ProMax[https://github.com/001ProMax]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id324684580
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://github.com/luestr/ProxyResource/blob/main/README.md
#!date=2025-06-11 00:00:00

[Argument]
tab=switch,true,false,tag=移除底栏创建按钮, desc=此开关控制是否移除底栏创建按钮
useractivity=switch,true,false,tag=启用Apple设备接力, desc=此开关控制是否使用Apple设备接力

[Rewrite]
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone/i then url.replace("https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad")

[Script]
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/001ProMax/Spotify/Spotify.Crack.Dev.js", {${tab}, ${useractivity}}) with tag="Protobuf", timeout=3, requires_body=true, binary_body_mode=true

[MITM]
hostname = *-spclient.spotify.com, spclient.wg.spotify.com

