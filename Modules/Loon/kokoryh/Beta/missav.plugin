[Rule]
DOMAIN,creative.myavlive.com,REJECT
DOMAIN-SUFFIX,trackwilltrk.com,REJECT
DOMAIN-SUFFIX,tsyndicate.com,REJECT

[Script]
response if ${url} ~= /^https:\/\/missav\.ai\/(?!favicon)(?!(build|fonts|img|js|api|cdn-cgi)\/)./i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/kokoryh/missav/webpage.missav.js") with tag="missav", requires_body=true

[MITM]
hostname = missav.ai

