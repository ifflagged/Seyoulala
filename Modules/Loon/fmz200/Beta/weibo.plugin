#!name=微博去广告&净化
#!desc=去除常见的广告和部分多余的模块
#!author=奶思[https://github.com/fmz200]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Loon/plugin/weibo.plugin
#!tg-channel=https://t.me/inaisi
#!tag=去广告, 微博, fmz200
#!system=iOS, iPadOS
#!date=2025-12-16 21:33:23

[Argument]
MainTabFilter=switch,true,false,tag = 顶部 Tab 过滤, desc = 顶部 Tab 过滤

[Rule]
# 收集用户信息，上传用户日志的请求
URL-REGEX,"^https?:\/\/api\.weibo\.cn\/2\/(push\/active|client\/addlog_batch|ad\/preload)",REJECT-DROP
URL-REGEX,"^https?:\/\/api-cloudim\.api\.weibo\.com\/v1\/log\/",REJECT-DROP
# 微博开屏广告
DOMAIN-SUFFIX,biz.weibo.com,REJECT
DOMAIN,bootpreload.uve.weibo.com,REJECT
# 其他广告
DOMAIN-SUFFIX,fastimage.uve.weibo.com,REJECT
DOMAIN-SUFFIX,adimg.vue.weibo.com,REJECT
DOMAIN-SUFFIX,zymo.mps.weibo.com,REJECT
DOMAIN-SUFFIX,weibomingzi.com,REJECT
DOMAIN-SUFFIX,sdkapp.uve.weibo.com,REJECT
DOMAIN-SUFFIX,promote.biz.weibo.cn,REJECT
DOMAIN-SUFFIX,gw5.push.mcp.weibo.cn,REJECT
DOMAIN-SUFFIX,gw6.push.mcp.weibo.cn,REJECT
DOMAIN-SUFFIX,game.weibo.cn,REJECT
DOMAIN-SUFFIX,adimg.uve.weibo.com,REJECT
DOMAIN-SUFFIX,game.weibo.com,REJECT
DOMAIN-SUFFIX,ads.viber.com,REJECT
DOMAIN-SUFFIX,ads-d.viber.com,REJECT
DOMAIN-SUFFIX,ads.aws.viber.com,REJECT
DOMAIN-SUFFIX,alitui.weibo.com,REJECT
DOMAIN-SUFFIX,dp.im.weibo.cn,REJECT
DOMAIN-SUFFIX,biz.weibo.com.cn,REJECT
DOMAIN-SUFFIX,click.uve.weibo.com,REJECT
DOMAIN-SUFFIX,wax.weibo.com,REJECT
DOMAIN-SUFFIX,wbapp.uve.weibo.com,REJECT
DOMAIN-SUFFIX,widget.weibo.com,REJECT
DOMAIN-SUFFIX,dsp.edm.weibo.cn,REJECT
DOMAIN-SUFFIX,alitui.weibo.com.cn,REJECT
DOMAIN-SUFFIX,tui.weibo.com,REJECT
DOMAIN-SUFFIX,wax.weibo.com.cn,REJECT
DOMAIN-SUFFIX,ad.weibo.com,REJECT
# 屏蔽信息收集
DOMAIN,datacollection.uve.weibo.com,REJECT
DOMAIN,adpinpai.video.weibocdn.com,REJECT

[Rewrite]
response if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends&/i then response.json.jq("del(.data.banner)")
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/cardlist\?/i then response.json.jq("del(.items[] | select(.category == \"group\"))")
# 热门视频 | 热推荐
request if ${url} ~= /^https?:\/\/api\.weibo\.c(n|om)\/\d\/(cardlist\?v_f=\d|ad\/weibointl\?)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=hot_search_users/i then reject_dict(200)
# 微博轻享版热搜词
request if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=get_searching_info/i then reject_dict(200)
# 私信中绿洲的擦边诱导推广
request if ${url} ~= /^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=treehole&auth=/i then reject_dict(200)
# 屏蔽首页左上角每日的弹窗tips
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/push\/daily/i then reject_dict(200)
# 超话按钮的提示
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/!\/huati\/(discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)\?/i then reject_dict(200)
# 开屏广告
request if ${url} ~= /^https?:\/\/bootrealtime\.uve\.weibo\.com\/v\d\/ad\/realtime/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/bootpreload\.uve\.weibo\.com\/v\d\/ad\/preload/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(get-lbs-cell-info\.php|sdkconfig\.php)/i then reject(200)
# 微博长文章推广
request if ${url} ~= /^https:\/\/card\.weibo\.com\/article\/m\/aj\/(reward|uvead)\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(reward|uvead)\?/i then reject_dict(200)
# 微博
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/!\/huati\/discovery_home_bottom_channels/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/!\/chaohua\/discovery\/home_bottom\/switch/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/!\/was\/finder\/searchbarchange\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/logservice\/service\?/i then reject(200)
request if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/push\/info\?/i then reject(200)

[Script]
# 微博移除发现页广告
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/search\/(finder|container_timeline|container_discover)\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博移除发现页广告", timeout=60, requires_body=true

# 微博热搜页面广告
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/(page|flowpage)\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博热搜页面广告", timeout=60, requires_body=true

# 微博话题页面广告
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/searchall\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博话题页面广告", timeout=60, requires_body=true

# 微博超话页面广告
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_timeline_topicpage\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博超话页面广告", timeout=60, requires_body=true

# 微博超话tab页净化
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_timeline_topic\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博超话tab页净化", timeout=60, requires_body=true

# 微博详情页面广告
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/extend\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博详情页面广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_detail\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博详情页面广告", timeout=60, requires_body=true

# 微博最顶部的tab页分组
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/groups\/allgroups\/v2/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博最顶部的tab页分组", timeout=60, enable=${MainTabFilter}, requires_body=true

# 微博评论区广告
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/comments\/mix_comments\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博评论区广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/(container_detail_comment|container_detail_mix)\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博评论区广告", timeout=60, requires_body=true

# 微博转发区广告
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/container_detail_forward\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_ads.js") with tag="微博转发区广告", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/statuses\/repost_timeline\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_main.js") with tag="微博转发区广告", timeout=60, requires_body=true

# 微博去广告以及去除各部分推广模块 - cherish
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/(cardlist|searchall|page|messageflow|statuses\/(unread_)?friends(\/|_)timeline|groups\/timeline|statuses\/(container_timeline|container_timeline_hot|unread_hot_timeline|extend|video_mixtimeline)|profile\/(me|container_timeline)|video\/(community_tab|remind_info|tiny_stream_video_list)|checkin\/show|(\!\/)?live\/media_homelist|comments\/build_comments|container\/get_item)/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_main.js") with tag="微博去广告以及去除各部分推广模块", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/(sdk|wb)app\.uve\.weibo\.com(\/interface\/sdk\/sdkad.php|\/wbapplua\/wbpullad.lua)/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_launch.js") with tag="微博去广告以及去除各部分推广模块", timeout=60, requires_body=true

# 自定义tab皮肤
response if ${url} ~= /^https?:\/\/m?api\.weibo\.c(n|om)\/2\/!\/client\/light_skin/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_main.js") with tag="自定义tab皮肤", timeout=60, requires_body=true

# 非会员设置tab皮肤 - cherish
response if ${url} ~= /^https?:\/\/new\.vip\.weibo\.c(n|om)\/littleskin\/preview/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_main.js") with tag="非会员设置tab皮肤", timeout=60, requires_body=true

# 解锁微博会员APP图标
response if ${url} ~= /^https?:\/\/new\.vip\.weibo\.c(n|om)\/aj\/appicon\/list/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/fmz200/weibo/weibo_vip.js") with tag="解锁微博会员APP图标", timeout=60, requires_body=true

[MITM]
hostname = *.weibo.cn, *.weibo.com, weibo.com

