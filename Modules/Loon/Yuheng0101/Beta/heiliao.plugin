#!name=黑料不打烊
#!desc=去除烦人的广告
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!date=2026-10-03 02:48:54

[Script]
response if ${url} ~= /^https?:\/\/(18hlw\.com).*/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Yuheng0101/heiliao/web.js") with tag="黑料去广告", timeout=60, requires_body=true

response if ${url} ~= /^https:\/\/api(\d+)?.hlwapi(\d+)?\.com\/api\.php\/api\/index\/(config|userInfo|index|detail)/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Yuheng0101/heiliao/app.js") with tag="黑料App去广告", timeout=30, requires_body=true

[MITM]
hostname = 18hlw.com, api*.hlwapi*.com

