#!name=小红书 - XIAOHONGSHU
#!desc=小红书 – 你的生活兴趣社区
#!author=zirawell[https://github.com/zirawell]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id741292507
#!bundleId=com.xingin.discover
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2026-09-25

[Rule]
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,t-ads.xiaohongshu.com,REJECT
DOMAIN,ads-vp5.xhscdn.com,REJECT
DOMAIN,apm-native.xiaohongshu.com,REJECT
DOMAIN,spider-tracker.xiaohongshu.com,REJECT
DOMAIN,trace.rtbasia.com,REJECT

[Rewrite]
# httpDNS
request if ${url} ~= /^https?:\/\/mediacloud\.xiaohongshu\.com\/api\/httpdns\//i then reject(200)
# 开屏广告
request if ${url} ~= /^https?:\/\/\w+\.xiaohongshu\.com\/api\/sns\/v\d+(\/tag)?\/ads/i then reject(200)
request if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/home_guide/i then reject(200)
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/nike\/v\d\/update\/check/i then response.body.mock("json", "{}", 200)
# 笔记创作推荐
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/user_banner/i then response.body.mock("json", "{}", 200)
# 惊喜弹窗
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/surprisebox\/(?>get_style|open|submit_action)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash/i then response.body.mock("json", "{}", 200)
# 信息流
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/guide\?/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d+\/hey\/\w+\/hey_gallery/i then response.body.mock("json", "{}", 200)
# 评论区图片水印
^https?:\/\/ci\.xiaohongshu\.com\/system_config\/watermark mock-response-body data-type=tiny-gif status-code=200

[Script]
# 详情页小部件
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

# 关注页感兴趣的人
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/user\/followings\/followfeed/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

# 搜索页
response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(?>banner|hot)_list/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/(?>hint|trending)\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

# 图片水印,视频水印
response if ${url} ~= /^https?:\/\/(?>edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/(?>imagefeed|feed|videofeed|(live_photo|video)\/save)/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

response if ${url} ~= /^https?:\/\/(?>edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/(?>followfeed|homefeed)\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/recommend\/user\/follow_recommend\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/comment\/(?>list|sub_comments)\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

response if ${url} ~= /^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/interaction\/comment\/video\/download\?/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/xiaohongshu/xiaohongshu.js") with tag="xiaohongshu", requires_body=true

[MITM]
hostname = mediacloud.xiaohongshu.com, edith.xiaohongshu.com, www.xiaohongshu.com, rec.xiaohongshu.com, ci.xiaohongshu.com

