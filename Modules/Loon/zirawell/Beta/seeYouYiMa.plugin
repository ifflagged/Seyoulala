#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!date=2025-07-08

[Rule]
DOMAIN,ad.seeyouyima.com,REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/x\.seeyouyima\.com\/adx\/staticstics\?/i then reject(200)
request if ${url} ~= /^https?:\/\/axxd\.xmseeyouyima\.com\/ad/i then reject(200)
request if ${url} ~= /^https?:\/\/axxd\.xmseeyouyima\.com\/.*getad\?/i then reject(200)
response if ${url} ~= /^https?:\/\/wxproj\.seeyouyima\.com\/data\/today_tips/i then response.body.mock("json", "{}", 200)

[MITM]
hostname = x.seeyouyima.com, axxd.xmseeyouyima.com, wxproj.seeyouyima.com

