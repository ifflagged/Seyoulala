[Rewrite]
response if ${url} ~= /^https?:\/\/wechat-api-dj\.mstand\.cn\/scrm\/app\/mdm\/index\/listAdv\?types=(?!1&)/i then response.body.mock("json", "{}", 200)
response if ${url} ~= /^https?:\/\/wechat-api-dj\.mstand\.cn\/system\/dms\/dmsAdSetting\/issue/i then response.body.mock("json", "{}", 200)

[Script]
response if ${url} ~= /^https?:\/\/wechat-api-dj\.mstand\.cn\/scrm\/mini\/app\/index\/info/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/zirawell/mstand/wechatApplet.js") with tag="mstand", requires_body=true

[MITM]
hostname = wechat-api-dj.mstand.cn

