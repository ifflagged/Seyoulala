#!name=Bilibili Helper
#!desc=去除扰人内容 & 禁用 P2P 连接
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

[Rewrite]
# 禁用 P2P 连接
http-request ^https:\/\/app\.bilibili\.com\/x\/v2\/(splash|search\?|feed\/index) header-del 'x-tf-isp'
http-request ^https:\/\/app\.bilibili\.com\/x\/v2\/(splash|search\?|feed\/index) header-add 'x-tf-isp' '{运营商}'
http-request ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.show\.v1 header-replace 'x-bili-network-bin' '{网络信息}'
http-request ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|ViewProgress)$ header-replace 'x-bili-network-bin' '{网络信息}'
http-request ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView header-replace 'x-bili-network-bin' '{网络信息}'
http-request ^https:\/\/grpc\.biliapi\.net\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$ header-replace 'x-bili-network-bin' '{网络信息}'
http-request ^https:\/\/grpc\.biliapi\.net\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView header-replace 'x-bili-network-bin' '{网络信息}'

[Script]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/(splash|search\?|feed\/index)/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Maasea/Bilibili.Helper/bilibili.helper.v2.js") with tag="bilibili.helper.v2", requires_body=true

response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.community\.service\.dm\.v1\.DM\/DmView/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Maasea/Bilibili.Helper/bilibili.helper.js") with tag="bilibili.helper.dmView", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Maasea/Bilibili.Helper/bilibili.helper.js") with tag="bilibili.helper.teenager", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|ViewProgress)$/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Maasea/Bilibili.Helper/bilibili.helper.js") with tag="bilibili.helper.v1.view", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Maasea/Bilibili.Helper/bilibili.helper.js") with tag="bilibili.helper.mainList", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Maasea/Bilibili.Helper/bilibili.helper.js") with tag="bilibili.helper.searchAll", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/Maasea/Bilibili.Helper/bilibili.helper.js") with tag="bilibili.helper.dynAll", requires_body=true, binary_body_mode=true

[MITM]
hostname = grpc.biliapi.net, app.bilibili.com

