[Script]
request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/githubdulong/jd_price2/jd_price.js") with tag="MMMCK_SCRIPT", timeout=60, requires_body=true

response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://github.com/ifflagged/Seyoulala/raw/main/Modules/JS/githubdulong/jd_price2/jd_price.js") with tag="京东比价", timeout=60, requires_body=true

[MITM]
hostname = in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com

